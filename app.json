{
  "expo": {
    "name": "my-diet",
    "slug": "my-diet",
    "version": "1.4.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#A8E6C9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zhongchaojun.mydiet"
    },
    "android": {
      "package": "com.zhongchaojun.mydiet",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#A8E6C9"
      }
    },
    "web": {},
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ]
  }
}
